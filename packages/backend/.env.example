CONVEX_DEPLOYMENT=dev:<deployment>
CONVEX_URL=https://<deployment>.convex.cloud
CONVEX_SITE_URL=https://<deployment>.convex.site

# Required Convex env var for the song import (https://audiometa.io/dashboard/api).
# One key, or several comma-separated keys (one crawl worker per key).
# pnpm exec convex env set AUDIOMETA_API_KEY <key-1>,<key-2>
# Start or refresh the 1B+ Spotify streams song catalog (also runs daily):
# pnpm exec convex run catalog:startImport
# Crawl every BPM bucket and store all songs with 100M+ Spotify streams:
# pnpm exec convex run catalog:startCrawl
# Or a BPM range only:
# pnpm exec convex run catalog:startCrawl '{"fromBpm":120,"toBpm":130}'
